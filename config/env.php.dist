<?php

// Fallback only. The process environment wins: a non-empty CONDUCTOR_ENVIRONMENT or
// CONDUCTOR_CRYPT_KEY variable overrides the value here (see ConductorCore\Config\EnvironmentConfig).
// Copy to env.php — which must stay out of version control — when the environment cannot supply them.
// The crypt key is only needed while the configuration still carries ENC[...] values; a configuration
// that takes its secrets from ${VAR} placeholders needs none.
return [
    'environment' => 'CONDUCTOR_ENVIRONMENT',
    'crypt_key' => 'CONDUCTOR_CRYPT_KEY',
];
